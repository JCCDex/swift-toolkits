# This file contains the fastlane configuration for swift-toolkits.
#
# This is a Swift Package Manager project (no Xcode project/workspace).
# The lanes run tests via `xcodebuild` against the generated SPM scheme and
# then produce HTML / JSON / Markdown coverage reports with `xcov`
# (`is_swift_package` mode, fed with the `.xcresult` bundle directly).

default_platform(:ios)

# fastlane 会把工作目录切到 Fastfile 所在目录（fastlane/），
# 而 SwiftPM / xcodebuild 需要在包根目录运行。此方法向上查找 Package.swift。
def package_root
  dir = Dir.pwd
  until File.exist?(File.join(dir, "Package.swift"))
    parent = File.dirname(dir)
    UI.user_error!("Package.swift not found above #{dir}") if parent == dir
    dir = parent
  end
  dir
end

# 返回 DerivedData 中最近一次 xcodebuild test 产生的 .xcresult 包。
def latest_xcresult(derived_data)
  xcresults = Dir.glob("#{derived_data}/Logs/Test/*.xcresult")
  if xcresults.empty?
    UI.user_error!("No .xcresult found under #{derived_data}/Logs/Test")
  end
  xcresults.max_by { |path| File.mtime(path) }
end

# 用 xcov 从 .xcresult 生成覆盖率报告（HTML + JSON + Markdown）。
def generate_xcov_report(xcresult:, output_dir:)
  FileUtils.mkdir_p(output_dir)
  xcov(
    is_swift_package: true,
    xccov_file_direct_path: [xcresult],
    output_directory: output_dir,
    source_directory: Dir.pwd,
    html_report: true,
    markdown_report: true,
    json_report: true,
    include_test_targets: false,
    include_zero_targets: true,
    ignore_file_path: File.join(Dir.pwd, ".xcovignore")
  )
  UI.success("xcov report written to #{output_dir}/ (index.html, report.json, report.md)")
end

# 解析（或创建）一个可用的 iOS 模拟器，返回其 UDID。
def resolve_or_create_simulator(device_name)
  device_id = sh("xcrun", "simctl", "list", "devices", "available", "--json")
              .then { |json| JSON.parse(json) }
              .then { |d| d["devices"] }
              .values.flatten
              .find { |dev| dev["name"] == device_name && dev["isAvailable"] == true }
              &.fetch("udid")

  if device_id.nil?
    # Create a new simulator
    runtime = sh("xcrun", "simctl", "list", "runtimes", "--json")
              .then { |json| JSON.parse(json) }
              .then { |r| r["runtimes"] }
              .find { |rt| rt["name"] =~ /iOS/ && rt["isAvailable"] == true && !rt["identifier"].include?("beta") }

    if runtime.nil?
      UI.user_error!("No available iOS runtime found")
    end

    device_type_id = sh("xcrun", "simctl", "list", "devicetypes", "--json")
                     .then { |json| JSON.parse(json) }
                     .then { |d| d["devicetypes"] || d["deviceTypes"] || [] }
                     .find { |dt| dt["name"] =~ /iPhone 16/ }
                     &.fetch("identifier")

    if device_type_id.nil?
      UI.user_error!("iPhone 16 device type not found")
    end

    device_id = sh("xcrun", "simctl", "create", device_name, device_type_id, runtime["identifier"]).strip
    UI.message("Created simulator '#{device_name}' (#{device_id})")
  end

  device_id
end

platform :ios do

  # ── Lane: run macOS tests with code coverage ────────────────────────────
  # Uses `xcodebuild test` with the SPM scheme so Xcode produces an .xcresult
  # bundle, which xcov can parse for the coverage report.
  desc "Run macOS tests with coverage (xcodebuild + xcov)"
  lane :macos_test do |options|
    root         = package_root
    scheme       = options[:scheme] || "swift-toolkits-Package"
    coverage_dir = options[:output_dir] || "#{root}/coverage/macos"
    derived_data = "#{root}/.build/DerivedData/macos-coverage"

    Dir.chdir(root) do
      FileUtils.mkdir_p(derived_data)

      sh("xcodebuild", "test",
         "-skipPackagePluginValidation",
         "-scheme", scheme,
         "-destination", "platform=macOS",
         "-enableCodeCoverage", "YES",
         "-derivedDataPath", derived_data,
         "-quiet")

      generate_xcov_report(
        xcresult: latest_xcresult(derived_data),
        output_dir: coverage_dir
      )
    end
  end

  # ── Lane: run iOS Simulator tests with code coverage ────────────────────
  # Resolves (or creates) an iPhone simulator, runs the SPM scheme with code
  # coverage, then feeds the resulting .xcresult to xcov.
  desc "Run iOS Simulator tests with coverage (xcodebuild + xcov)"
  lane :ios_test do |options|
    root         = package_root
    scheme       = options[:scheme] || "swift-toolkits-Package"
    device_name  = options[:device_name] || "iPhone 16"
    coverage_dir = options[:output_dir] || "#{root}/coverage/ios"
    derived_data = "#{root}/.build/DerivedData/ios-coverage"

    Dir.chdir(root) do
      # Resolve destination
      device_id = resolve_or_create_simulator(device_name)

      UI.message("Running tests on simulator #{device_id}")
      FileUtils.mkdir_p(derived_data)

      # xcodebuild 必须在包根目录运行（CWD 需包含 Package.swift）
      sh("xcodebuild", "test",
         "-skipPackagePluginValidation",
         "-scheme", scheme,
         "-destination", "id=#{device_id}",
         "-enableCodeCoverage", "YES",
         "-derivedDataPath", derived_data,
         "-quiet")

      generate_xcov_report(
        xcresult: latest_xcresult(derived_data),
        output_dir: coverage_dir
      )
    end
  end

  # ── Lane: run all tests (macOS + iOS) with coverage ─────────────────────
  desc "Run all tests (macOS + iOS Simulator) with coverage"
  lane :all_tests do |options|
    coverage_dir = options[:output_dir] || "coverage"

    UI.header("Running macOS tests")
    macos_test(output_dir: "#{coverage_dir}/macos")

    UI.header("Running iOS Simulator tests")
    ios_test(output_dir: "#{coverage_dir}/ios")

    UI.success("All tests completed. Coverage in #{coverage_dir}/")
  end

  # ── Lane: only run iOS tests (no coverage, fast path) ───────────────────
  desc "Run iOS Simulator tests only (no coverage)"
  lane :ios_test_only do |options|
    scheme      = options[:scheme] || "swift-toolkits-Package"
    device_name = options[:device_name] || "iPhone 16"

    sh("bash", "Scripts/test_ios_simulator.sh",
       "SCHEME" => scheme,
       "DEVICE_NAME" => device_name)
  end

end
